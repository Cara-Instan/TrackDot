<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Version>0.1.0</Version>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>TrackDot</RootNamespace>
    <AssemblyName>TrackDot</AssemblyName>
    <UseWindowsForms>false</UseWindowsForms>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="Kawazu" Version="1.0.0" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
    <Page Remove="tests\**\*.xaml" />
    <ApplicationDefinition Remove="tests\**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" Condition="Exists('Assets\AppIcon.ico')" />
    <Resource Include="Assets\PlaceholderArt.png" Condition="Exists('Assets\PlaceholderArt.png')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TrackDot.Tests" />
  </ItemGroup>

  <Target Name="CopyKawazuIpaDic" AfterTargets="Build;Publish">
    <ItemGroup>
      <_KawazuDicFiles Condition="Exists('$(PkgKawazu)\contentFiles\any\netcoreapp3.1')" Include="$(PkgKawazu)\contentFiles\any\netcoreapp3.1\*.*" />
      <_KawazuDicFiles Condition="!Exists('$(PkgKawazu)\contentFiles\any\netcoreapp3.1') and Exists('$(PkgKawazu)\contentFiles\any\netstandard2.0')" Include="$(PkgKawazu)\contentFiles\any\netstandard2.0\*.*" />
      <_KawazuDicFiles Condition="!Exists('$(PkgKawazu)\contentFiles\any\netcoreapp3.1') and !Exists('$(PkgKawazu)\contentFiles\any\netstandard2.0') and Exists('$(PkgKawazu)\content')" Include="$(PkgKawazu)\content\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_KawazuDicFiles)" DestinationFolder="$(TargetDir)IpaDic" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)')" />
    <Copy SourceFiles="@(_KawazuDicFiles)" DestinationFolder="$(PublishDir)IpaDic" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>

</Project>