<Window x:Class="TrackDot.HotkeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Shortcuts" Width="380" SizeToContent="Height"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PanelBrush}"
        KeyDown="Window_KeyDown" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="HotkeyKeyCapStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BadgeBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="HotkeyKeyCapTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="Consolas, Segoe UI, sans-serif" />
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource BadgeBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="18">
        <StackPanel>
            <!-- Title Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Path Data="M 2,4 H 22 V 18 H 2 Z M 4,6 V 8 H 7 V 6 Z M 9,6 V 8 H 12 V 6 Z M 14,6 V 8 H 17 V 6 Z M 19,6 V 8 H 20 V 6 Z M 4,10 V 12 H 6 V 10 Z M 8,10 V 12 H 16 V 10 Z M 18,10 V 12 H 20 V 10 Z M 4,14 V 16 H 20 V 14 Z"
                      Fill="{DynamicResource AccentBrush}"
                      Width="20" Height="20" Stretch="Uniform"
                      VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Keyboard Shortcuts" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="Quick keys for TrackDot popover" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Shortcut Rows -->
            <Border Background="{DynamicResource BadgeBackgroundBrush}"
                    BorderBrush="{DynamicResource BadgeBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,8">
                <StackPanel>
                    <!-- Global Toggle Popover -->
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Toggle Popover" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Style="{StaticResource HotkeyKeyCapStyle}">
                                <TextBlock Text="Alt" Style="{StaticResource HotkeyKeyCapTextStyle}" />
                            </Border>
                            <TextBlock Text="+" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="2,0" />
                            <Border Style="{StaticResource HotkeyKeyCapStyle}">
                                <TextBlock Text="Shift" Style="{StaticResource HotkeyKeyCapTextStyle}" />
                            </Border>
                            <TextBlock Text="+" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="2,0" />
                            <Border Style="{StaticResource HotkeyKeyCapStyle}">
                                <TextBlock Text="T" Style="{StaticResource HotkeyKeyCapTextStyle}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource BadgeBorderBrush}" Margin="0,4" />

                    <!-- Play / Pause -->
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Play / Pause" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Style="{StaticResource HotkeyKeyCapStyle}">
                                <TextBlock Text="Space" Style="{StaticResource HotkeyKeyCapTextStyle}" />
                            </Border>
                            <TextBlock Text="or" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="4,0" FontSize="11" />
                            <Border Style="{StaticResource HotkeyKeyCapStyle}">
                                <TextBlock Text="Media Key" Style="{StaticResource HotkeyKeyCapTextStyle}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource BadgeBorderBrush}" Margin="0,4" />

                    <!-- Next Track -->
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Next Track" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Style="{StaticResource HotkeyKeyCapStyle}">
                            <TextBlock Text="Media Next" Style="{StaticResource HotkeyKeyCapTextStyle}" />
                        </Border>
                    </Grid>

                    <Separator Background="{DynamicResource BadgeBorderBrush}" Margin="0,4" />

                    <!-- Previous Track -->
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Previous Track" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Style="{StaticResource HotkeyKeyCapStyle}">
                            <TextBlock Text="Media Prev" Style="{StaticResource HotkeyKeyCapTextStyle}" />
                        </Border>
                    </Grid>

                    <Separator Background="{DynamicResource BadgeBorderBrush}" Margin="0,4" />

                    <!-- Hide / Close Popover -->
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hide Popover" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Style="{StaticResource HotkeyKeyCapStyle}">
                            <TextBlock Text="Esc" Style="{StaticResource HotkeyKeyCapTextStyle}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bottom Close Button -->
            <Button Content="Close" Style="{StaticResource CloseButtonStyle}"
                    HorizontalAlignment="Right" Margin="0,16,0,0"
                    Click="OnCloseClicked" />
        </StackPanel>
    </Border>
</Window>
