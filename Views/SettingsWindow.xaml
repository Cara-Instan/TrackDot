<Window x:Class="TrackDot.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrackDot — Settings"
        Width="440" SizeToContent="Height"
        MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource TextBrush}"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        Icon="pack://application:,,,/TrackDot;component/Assets/AppIcon.ico">
    <Window.Resources>
        <Style x:Key="StatusRowStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusMessage}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Theme RadioButton Style -->
        <Style x:Key="ThemeRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Styled Window Button -->
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BadgeBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="16">
            <StackPanel>
                <TextBlock Text="Settings"
                           FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
                
                <!-- Appearance / Theme Section -->
                <TextBlock Text="Appearance"
                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton Content="System default"
                                 IsChecked="{Binding IsSystemTheme, Mode=TwoWay}"
                                 Style="{StaticResource ThemeRadioButtonStyle}" />
                    <RadioButton Content="Dark"
                                 IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                 Style="{StaticResource ThemeRadioButtonStyle}" />
                    <RadioButton Content="Light"
                                 IsChecked="{Binding IsLightTheme, Mode=TwoWay}"
                                 Style="{StaticResource ThemeRadioButtonStyle}" />
                </StackPanel>

                <!-- Dynamic Tinting CheckBox -->
                <CheckBox Content="Dynamic Album Art Palette Tinting &amp; Ambient Glow"
                          IsChecked="{Binding EnableDynamicTinting, Mode=TwoWay}"
                          Foreground="{DynamicResource TextBrush}"
                          Margin="0,0,0,14" />

                <!-- Lyrics & Floating HUD Section -->
                <TextBlock Text="Lyrics &amp; Floating HUD"
                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

                <CheckBox Content="Show Translation / Romaji secondary lyric lines"
                          IsChecked="{Binding LyricsShowTranslation, Mode=TwoWay}"
                          Foreground="{DynamicResource TextBrush}"
                          Margin="0,0,0,8" />

                <CheckBox Content="Lock Floating HUD in click-through mode"
                          IsChecked="{Binding LyricsHudIsLocked, Mode=TwoWay}"
                          Foreground="{DynamicResource TextBrush}"
                          ToolTip="When locked, clicks pass through HUD directly to games/applications"
                          Margin="0,0,0,12" />

                <!-- HUD Opacity -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="HUD Opacity" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider Width="110" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding LyricsHudOpacityPercent, Mode=TwoWay}"
                                VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource VolumeSliderStyle}" />
                        <TextBlock Text="{Binding LyricsHudOpacityDisplayText}" Foreground="{DynamicResource TextBrush}" FontSize="12" Width="38" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Popover Opacity -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Popover Opacity" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                        <TextBlock Text="Adjust transparency of the floating mini player" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider Width="110" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding OpacityPercent, Mode=TwoWay}"
                                VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource VolumeSliderStyle}" />
                        <TextBlock Text="{Binding OpacityDisplayText}" Foreground="{DynamicResource TextBrush}" FontSize="12" Width="38" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- HUD Font Size -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="HUD Font Size" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider Width="110" Minimum="14" Maximum="60" TickFrequency="2" IsSnapToTickEnabled="True"
                                Value="{Binding LyricsHudFontSize, Mode=TwoWay}"
                                VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource VolumeSliderStyle}" />
                        <TextBlock Text="{Binding LyricsHudFontSize, StringFormat='{}{0:0}px'}" Foreground="{DynamicResource TextBrush}" FontSize="12" Width="38" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Global Hotkeys Section -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Shortcuts &amp; Global Hotkeys"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Reset Defaults"
                            Style="{StaticResource SettingsButtonStyle}"
                            Click="OnResetHotkeysClicked"
                            ToolTip="Reset all global hotkeys to default bindings" />
                </Grid>

                <CheckBox x:Name="EnableGlobalHotkeysCheckBox"
                          Content="Enable system-wide global hotkeys"
                          IsChecked="{Binding EnableGlobalHotkeys, Mode=TwoWay}"
                          Foreground="{DynamicResource TextBrush}"
                          Margin="0,0,0,10" />

                <!-- Hotkeys Customization List -->
                <Border Background="{DynamicResource BadgeBackgroundBrush}"
                        BorderBrush="{DynamicResource BadgeBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,16">
                    <ItemsControl ItemsSource="{Binding HotkeyItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="{Binding GestureText}"
                                            Click="OnRecordHotkeyClicked"
                                            MinWidth="110"
                                            ToolTip="Click and press shortcut to rebind (Esc to cancel)">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SettingsButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Discord Rich Presence & Privacy Section -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Discord Rich Presence &amp; Privacy"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Clear Apps"
                            Style="{StaticResource SettingsButtonStyle}"
                            Click="OnClearSourceAppsClicked"
                            ToolTip="Clear list of discovered source applications" />
                </Grid>

                <CheckBox Content="Enable Discord Rich Presence (RPC)"
                          IsChecked="{Binding EnableDiscordRpc, Mode=TwoWay}"
                          Foreground="{DynamicResource TextBrush}"
                          Margin="0,0,0,8" />

                <StackPanel Margin="22,0,0,10" IsEnabled="{Binding EnableDiscordRpc}">
                    <CheckBox Content="Show elapsed &amp; remaining track timestamps"
                              IsChecked="{Binding DiscordShowTimestamps, Mode=TwoWay}"
                              Foreground="{DynamicResource TextBrush}"
                              Margin="0,0,0,6" />
                    <CheckBox Content="Show album title"
                              IsChecked="{Binding DiscordShowAlbum, Mode=TwoWay}"
                              Foreground="{DynamicResource TextBrush}"
                              Margin="0,0,0,6" />
                    <CheckBox Content="Show &quot;Paused&quot; status when playback is paused"
                              IsChecked="{Binding DiscordShowPauseStatus, Mode=TwoWay}"
                              Foreground="{DynamicResource TextBrush}"
                              Margin="0,0,0,8" />
                </StackPanel>

                <!-- Source Apps Whitelist Box -->
                <Border Background="{DynamicResource BadgeBackgroundBrush}"
                        BorderBrush="{DynamicResource BadgeBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Allowed Source Applications"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="TrackDot automatically discovers media player apps when they play audio. By default, newly discovered apps are disabled to protect your privacy."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11" Margin="0,0,0,8" />

                        <!-- When no apps registered -->
                        <TextBlock Text="No source apps registered yet. Play music in Spotify, Chrome, etc., and they will appear here."
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontStyle="Italic"
                                   FontSize="11" Margin="0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSourceApps}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Items list -->
                        <ItemsControl ItemsSource="{Binding SourceAppItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="12" FontWeight="Medium" />
                                            <TextBlock Text="{Binding Aumid}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Content="Share"
                                                  IsChecked="{Binding DiscordRpcEnabled, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextBrush}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Startup Section -->
                <TextBlock Text="Startup"
                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                <CheckBox x:Name="LaunchAtSignInCheckBox"
                          Content="Launch TrackDot at sign-in"
                          IsChecked="{Binding LaunchAtSignIn, Mode=TwoWay}"
                          Foreground="{DynamicResource TextBrush}"
                          Margin="0,0,0,6" />
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="12"
                           Margin="22,0,0,12">
                    <Run Text="When enabled, TrackDot starts automatically when you sign in to Windows." />
                    <LineBreak />
                    <Run Text="The setting is stored per user in the registry:" />
                    <LineBreak />
                    <Run Text="{Binding RegistryKeyPath, Mode=OneWay}" FontFamily="Consolas" />
                    <Run Text=" / " />
                    <Run Text="{Binding RegistryValueName, Mode=OneWay}" FontFamily="Consolas" />
                </TextBlock>
                <TextBlock x:Name="StatusRow"
                           Text="{Binding StatusMessage, Mode=OneWay}"
                           Foreground="{DynamicResource StatusErrorBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Style="{StaticResource StatusRowStyle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Width="80" Height="28"
                            Style="{StaticResource SettingsButtonStyle}"
                            Click="OnCloseClicked"
                            IsCancel="True" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>