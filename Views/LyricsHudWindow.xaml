<Window x:Class="TrackDot.Views.LyricsHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrackDot.ViewModels"
        mc:Ignorable="d"
        Title="TrackDot — Lyrics HUD"
        Width="720" Height="100"
        MinWidth="300" MinHeight="60"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent" AllowsTransparency="True"
        AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop"
        Closing="Window_Closing" MouseLeftButtonDown="Window_MouseLeftButtonDown" SizeChanged="Window_SizeChanged"
        Icon="pack://application:,,,/TrackDot;component/Assets/AppIcon.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      CaptionHeight="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <!-- Background Panel Layer (Transparent / Semi-transparent per WindowOpacity) -->
        <Border Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Opacity="{Binding WindowOpacity}">
            <!-- Dynamic Ambient Glow from Artwork -->
            <Border Background="{Binding ArtworkAmbientGlowBrush}"
                    CornerRadius="12"
                    IsHitTestVisible="False" />
        </Border>

        <!-- Main Content Area -->
        <Grid Margin="12,6">
            <Grid.RowDefinitions>
                <!-- Lyrics Display Area -->
                <RowDefinition Height="*" />
                <!-- Hover Controls Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Active Lyrics Text -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Active Line when available -->
                <StackPanel Visibility="{Binding HasActiveLine, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Visible}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Furigana Reading Segment Blocks -->
                    <ItemsControl ItemsSource="{Binding ActiveLine.Segments}" HorizontalAlignment="Center">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFuriganaVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" Margin="1,0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Reading}"
                                               FontSize="{Binding DataContext.RubyFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Visibility="{Binding HasReading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding Surface}"
                                               FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.HasDynamicAccent, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Foreground" Value="{Binding DataContext.DynamicAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Standard Text when Furigana is OFF -->
                    <TextBlock Text="{Binding ActiveLine.Text}"
                               FontSize="{Binding FontSize}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFuriganaVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasDynamicAccent}" Value="True">
                                        <Setter Property="Foreground" Value="{Binding DynamicAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Translation / Secondary Line -->
                    <TextBlock Text="{Binding ActiveLine.SecondaryText}"
                               FontSize="{Binding SecondaryFontSize}"
                               Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsTranslationVisible}" Value="True" />
                                            <Condition Binding="{Binding ActiveLine.HasSecondaryText}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- No Active Lyric Line Placeholder (Show Song Info) -->
                <StackPanel Visibility="{Binding HasActiveLine, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayTitle}"
                               FontSize="{Binding FontSize}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DisplayArtist}"
                               FontSize="{Binding SecondaryFontSize}"
                               Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Hover Controls Toolbar (Hidden when Locked / WS_EX_TRANSPARENT) -->
            <Border x:Name="HoverToolbar" Grid.Row="1" Margin="0,4,0,0"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6,3"
                    HorizontalAlignment="Center"
                    Opacity="0"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Lock / Click-Through Button -->
                    <Button Style="{StaticResource HeaderActionButton}"
                            Command="{Binding ToggleLockCommand}"
                            ToolTip="Lock HUD (Enable click-through over games/apps)"
                            AutomationProperties.Name="Lock HUD">
                        <Path Data="M 12,17 A 2,2 0 0,0 14,15 C 14,13.9 13.1,13 12,13 A 2,2 0 0,0 10,15 A 2,2 0 0,0 12,17 M 18,8 A 2,2 0 0,1 20,10 V 20 A 2,2 0 0,1 18,22 H 6 A 2,2 0 0,1 4,20 V 10 A 2,2 0 0,1 6,8 H 7 V 6 A 5,5 0 0,1 12,1 A 5,5 0 0,1 17,6 V 8 H 18 M 12,3 A 3,3 0 0,0 9,6 V 8 H 15 V 6 A 3,3 0 0,0 12,3 Z"
                              Fill="{DynamicResource MutedBrush}"
                              Width="12" Height="12" Stretch="Uniform" />
                    </Button>

                    <Rectangle Width="1" Height="12" Fill="{DynamicResource CardBorderBrush}" Margin="4,0" />

                    <!-- Mini Transport Buttons -->
                    <Button Style="{StaticResource HeaderActionButton}"
                            Command="{Binding PreviousTrackCommand}"
                            IsEnabled="{Binding CanGoPrevious}"
                            ToolTip="Previous Track">
                        <Path Data="M 6,6 H 8 V 18 H 6 Z M 9.5,12 L 18,18 V 6 Z"
                              Fill="{DynamicResource MutedBrush}"
                              Width="11" Height="11" Stretch="Uniform" />
                    </Button>

                    <Button Style="{StaticResource HeaderActionButton}"
                            Command="{Binding PlayPauseCommand}"
                            IsEnabled="{Binding CanPlayPause}"
                            ToolTip="Play / Pause">
                        <Path Data="M 8,5.14 V 19.14 L 19,12.14 L 8,5.14 Z"
                              Fill="{DynamicResource AccentBrush}"
                              Width="11" Height="11" Stretch="Uniform" />
                    </Button>

                    <Button Style="{StaticResource HeaderActionButton}"
                            Command="{Binding NextTrackCommand}"
                            IsEnabled="{Binding CanGoNext}"
                            ToolTip="Next Track">
                        <Path Data="M 6,18 L 14.5,12 L 6,6 V 18 Z M 16,6 V 18 H 18 V 6 H 16 Z"
                              Fill="{DynamicResource MutedBrush}"
                              Width="11" Height="11" Stretch="Uniform" />
                    </Button>

                    <Rectangle Width="1" Height="12" Fill="{DynamicResource CardBorderBrush}" Margin="4,0" />

                    <!-- Furigana Toggle -->
                    <Button Style="{StaticResource HeaderActionButton}"
                            Command="{Binding ToggleFuriganaCommand}"
                            ToolTip="Toggle Furigana reading">
                        <TextBlock Text="あ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" />
                    </Button>

                    <!-- Translation Toggle -->
                    <Button Style="{StaticResource HeaderActionButton}"
                            Command="{Binding ToggleTranslationCommand}"
                            ToolTip="Toggle Translation / Secondary line">
                        <TextBlock Text="文" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" />
                    </Button>

                    <!-- Font Size Controls -->
                    <Button Style="{StaticResource HeaderActionButton}"
                            Command="{Binding DecreaseFontSizeCommand}"
                            ToolTip="Decrease Font Size">
                        <TextBlock Text="A-" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" />
                    </Button>

                    <Button Style="{StaticResource HeaderActionButton}"
                            Command="{Binding IncreaseFontSizeCommand}"
                            ToolTip="Increase Font Size">
                        <TextBlock Text="A+" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" />
                    </Button>

                    <Rectangle Width="1" Height="12" Fill="{DynamicResource CardBorderBrush}" Margin="4,0" />

                    <!-- Open Full Lyrics Button -->
                    <Button Style="{StaticResource HeaderActionButton}"
                            Click="OnOpenFullLyricsClicked"
                            ToolTip="Open Full Lyrics Window">
                        <Path Data="M 12,3 V 13.5 A 3.5,3.5 0 1,1 8.5,10 A 3.5,3.5 0 0,1 12,13.5 V 6 H 18 V 3 H 12 Z"
                              Fill="{DynamicResource MutedBrush}"
                              Width="11" Height="11" Stretch="Uniform" />
                    </Button>

                    <!-- Close HUD Button -->
                    <Button Style="{StaticResource HeaderActionButton}"
                            Click="OnCloseClicked"
                            ToolTip="Close Floating HUD">
                        <Path Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z"
                              Fill="{DynamicResource MutedBrush}"
                              Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

