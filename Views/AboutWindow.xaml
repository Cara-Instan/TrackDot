<Window x:Class="TrackDot.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About TrackDot"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource TextBrush}"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown"
        Icon="pack://application:,,,/TrackDot;component/Assets/AppIcon.ico">
    <Window.Resources>
        <!-- Styled Window Button -->
        <Style x:Key="AboutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BadgeBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" BasedOn="{StaticResource AboutButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="TextDecorations" Value="None" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Padding="20">
        <StackPanel>
            <!-- Header Section: Logo + Title + Version Badge -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="64" Height="64"
                        Background="{DynamicResource ArtworkBackgroundBrush}"
                        BorderBrush="{DynamicResource BadgeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        ClipToBounds="True">
                    <Image Source="pack://application:,,,/TrackDot;component/Assets/AppIcon.ico" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="TrackDot" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                        <Border Margin="10,0,0,0"
                                Padding="8,2"
                                CornerRadius="10"
                                Background="{DynamicResource BadgeBackgroundBrush}"
                                BorderBrush="{DynamicResource BadgeBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="VersionTextBlock" Text="v0.1.0-beta" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Windows SMTC Media Controller"
                               FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <!-- Card 1: Author & Repository -->
            <Border Background="{DynamicResource BadgeBackgroundBrush}"
                    BorderBrush="{DynamicResource BadgeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Main Author:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Grid.Column="1" FontSize="12">
                            <Hyperlink NavigateUri="https://github.com/herlandroando" RequestNavigate="Hyperlink_RequestNavigate">
                                herlandroando (Herlandro Ando)
                            </Hyperlink>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Repository:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Grid.Column="1" FontSize="12">
                            <Hyperlink NavigateUri="https://github.com/Cara-Instan/TrackDot" RequestNavigate="Hyperlink_RequestNavigate">
                                Cara-Instan/TrackDot
                            </Hyperlink>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="License:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Grid.Column="1" FontSize="12">
                            <Hyperlink NavigateUri="https://github.com/Cara-Instan/TrackDot/blob/main/LICENSE" RequestNavigate="Hyperlink_RequestNavigate">
                                MIT License
                            </Hyperlink>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Terms:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Grid.Column="1" FontSize="12">
                            <Hyperlink NavigateUri="https://github.com/Cara-Instan/TrackDot/blob/main/TERMS.md" RequestNavigate="Hyperlink_RequestNavigate">
                                Terms of Service
                            </Hyperlink>
                        </TextBlock>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Privacy:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Grid.Column="1" FontSize="12">
                            <Hyperlink NavigateUri="https://github.com/Cara-Instan/TrackDot/blob/main/PRIVACY.md" RequestNavigate="Hyperlink_RequestNavigate">
                                Privacy Policy
                            </Hyperlink>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: Description & AI Benchmark Notes -->
            <Border Background="{DynamicResource BadgeBackgroundBrush}"
                    BorderBrush="{DynamicResource BadgeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="About the Project"
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" LineHeight="18">
                        TrackDot is a lightweight, tray-first Windows media controller that binds directly to the Windows System Media Transport Controls (SMTC) API.
                    </TextBlock>
                    <Separator Background="{DynamicResource PanelBorderBrush}" Margin="0,10" Height="1" />
                    <TextBlock Text="AI Benchmark Architecture"
                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" LineHeight="16">
                        • Core Architecture &amp; WPF Composition: <Run Foreground="{DynamicResource TextBrush}">MiniMax-M3</Run><LineBreak />
                        • Planning &amp; Technical Refinements: <Run Foreground="{DynamicResource TextBrush}">Gemini 3.6 Flash</Run> &amp; <Run Foreground="{DynamicResource TextBrush}">Sonnet 4.6</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Action Buttons Footer -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="GitHub Repo"
                            Style="{StaticResource AboutButtonStyle}"
                            Margin="0,0,8,0"
                            Click="OnOpenRepoClicked" />
                    <Button Content="Author Profile"
                            Style="{StaticResource AboutButtonStyle}"
                            Click="OnOpenAuthorClicked" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Close"
                        Width="80"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnCloseClicked"
                        IsCancel="True" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
