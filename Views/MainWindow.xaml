<Window x:Class="TrackDot.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TrackDot.Controls"
        Title="TrackDot" Width="360" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" Background="Transparent" AllowsTransparency="True"
        Deactivated="Window_Deactivated" KeyDown="Window_KeyDown"
        Closing="Window_Closing" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Icon="pack://application:,,,/TrackDot;component/Assets/AppIcon.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
                      ResizeBorderThickness="0"
                      CaptionHeight="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <!-- Background Panel Layer (Transparent / Semi-transparent per WindowOpacity) -->
        <Border x:Name="BackgroundBorder"
                Background="{DynamicResource PanelBrush}" 
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <!-- Dynamic Ambient Glow from Artwork (Soft Radial Tint) -->
            <Border Background="{Binding ArtworkAmbientGlowBrush}"
                    CornerRadius="14"
                    IsHitTestVisible="False" />
        </Border>

        <!-- Foreground Content Layer (100% Opaque) -->
        <Grid Width="330" Margin="14,10,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="84" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header Action Buttons Toolbar (Pin, Lyrics, Lyrics HUD, Hotkeys, Settings, About) -->
            <Grid Grid.Row="0" Margin="0,0,0,8" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Pin / Keep Window Open Button -->
                    <Button x:Name="PinButton"
                            Style="{StaticResource HeaderActionButton}"
                            Click="OnPinClicked"
                            ToolTip="Pin popover (Keep window open)"
                            AutomationProperties.Name="Pin window">
                        <Path x:Name="PinIconPath"
                              Data="M 12,2 L 16,6 L 13,9 L 14,14 L 10,10 L 6,14 L 7,9 L 4,6 Z M 9,15 L 4,20"
                              Fill="{DynamicResource MutedBrush}"
                              Width="14" Height="14" Stretch="Uniform" />
                    </Button>

                    <!-- Lyrics Window Button -->
                    <Button Style="{StaticResource HeaderActionButton}"
                            Click="OnLyricsClicked"
                            ToolTip="Lyrics"
                            AutomationProperties.Name="Lyrics">
                        <Path Data="M 12,3 V 13.5 A 3.5,3.5 0 1,1 8.5,10 A 3.5,3.5 0 0,1 12,13.5 V 6 H 18 V 3 H 12 Z"
                              Fill="{DynamicResource MutedBrush}"
                              Width="13" Height="13" Stretch="Uniform" />
                    </Button>

                    <!-- Floating Lyrics HUD Button -->
                    <Button Style="{StaticResource HeaderActionButton}"
                            Click="OnLyricsHudClicked"
                            ToolTip="Lyrics HUD / Subtitle Mode"
                            AutomationProperties.Name="Lyrics HUD">
                        <Path Data="M 21,3 H 3 C 1.9,3 1,3.9 1,5 V 17 C 1,18.1 1.9,19 3,19 H 8 V 21 H 16 V 19 H 21 C 22.1,19 23,18.1 23,17 V 5 C 23,3.9 22.1,3 21,3 M 21,17 H 3 V 5 H 21 V 17 M 6,12 H 10 V 14 H 6 V 12 M 12,12 H 18 V 14 H 12 V 12 Z"
                              Fill="{DynamicResource MutedBrush}"
                              Width="13" Height="13" Stretch="Uniform" />
                    </Button>

                    <!-- Keyboard Shortcuts Button -->
                    <Button Style="{StaticResource HeaderActionButton}"
                            Click="OnHotkeysClicked"
                            ToolTip="Keyboard Shortcuts"
                            AutomationProperties.Name="Keyboard Shortcuts">
                        <Path Data="M 2,4 H 22 V 18 H 2 Z M 4,6 V 8 H 7 V 6 Z M 9,6 V 8 H 12 V 6 Z M 14,6 V 8 H 17 V 6 Z M 19,6 V 8 H 20 V 6 Z M 4,10 V 12 H 6 V 10 Z M 8,10 V 12 H 16 V 10 Z M 18,10 V 12 H 20 V 10 Z M 4,14 V 16 H 20 V 14 Z"
                              Fill="{DynamicResource MutedBrush}"
                              Width="13" Height="13" Stretch="Uniform" />
                    </Button>

                    <!-- Settings Window Button -->
                    <Button Style="{StaticResource HeaderActionButton}"
                            Click="OnSettingsClicked"
                            ToolTip="Settings"
                            AutomationProperties.Name="Settings">
                        <Path Data="M 19.14,12.94 C 19.18,12.63 19.2,12.32 19.2,12 C 19.2,11.68 19.18,11.37 19.14,11.06 L 21.46,9.25 C 21.67,9.08 21.73,8.78 21.59,8.54 L 19.39,4.73 C 19.25,4.49 18.96,4.4 18.72,4.49 L 15.99,5.59 C 15.43,5.16 14.82,4.8 14.16,4.53 L 13.75,1.63 C 13.71,1.37 13.48,1.18 13.22,1.18 L 8.8,1.18 C 8.54,1.18 8.31,1.37 8.27,1.63 L 7.86,4.53 C 7.2,4.8 6.59,5.16 6.03,5.59 L 3.3,4.49 C 3.06,4.4 2.77,4.49 2.63,4.73 L 0.43,8.54 C 0.29,8.78 0.35,9.08 0.56,9.25 L 2.88,11.06 C 2.84,11.37 2.82,11.68 2.82,12 C 2.82,12.32 2.84,12.63 2.88,12.94 L 0.56,14.75 C 0.35,14.92 0.29,15.22 0.43,15.46 L 2.63,19.27 C 2.77,19.51 3.06,19.6 3.3,19.51 L 6.03,18.41 C 6.59,18.84 7.2,19.2 7.86,19.47 L 8.27,22.37 C 8.31,22.63 8.54,22.82 8.8,22.82 L 13.22,22.82 C 13.48,22.82 13.71,22.63 13.75,22.37 L 14.16,19.47 C 14.82,19.2 15.43,18.84 15.99,18.41 L 18.72,19.51 C 18.96,19.6 19.25,19.51 19.39,19.27 L 21.59,15.46 C 21.73,15.22 21.67,14.92 21.46,14.75 Z M 11,15.5 C 9.07,15.5 7.5,13.93 7.5,12 C 7.5,10.07 9.07,8.5 11,8.5 C 12.93,8.5 14.5,10.07 14.5,12 C 14.5,13.93 12.93,15.5 11,15.5 Z"
                              Fill="{DynamicResource MutedBrush}"
                              Width="13" Height="13" Stretch="Uniform" />
                    </Button>

                    <!-- About Window Button -->
                    <Button Style="{StaticResource HeaderActionButton}"
                            Click="OnAboutClicked"
                            ToolTip="About TrackDot"
                            AutomationProperties.Name="About TrackDot">
                        <Path Data="M 11,7 H 13 V 9 H 11 Z M 11,11 H 13 V 17 H 11 Z M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,20 C 7.59,20 4,16.41 4,12 C 4,7.59 7.59,4 12,4 C 16.41,4 20,7.59 20,12 C 20,16.41 16.41,20 12,20 Z"
                              Fill="{DynamicResource MutedBrush}"
                              Width="13" Height="13" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Header: Artwork + Title / Artist / Source App Badge -->
            <Grid Grid.Row="1" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="84" Height="84" Background="{DynamicResource ArtworkBackgroundBrush}" CornerRadius="10" ClipToBounds="True">
                    <Grid>
                        <!-- Vector Fallback Music Eighth-Note Icon if artwork is null -->
                        <Path Data="M 12,3 V 13.5 A 3.5,3.5 0 1,1 8.5,10 A 3.5,3.5 0 0,1 12,13.5 V 6 H 18 V 3 H 12 Z" 
                               Fill="{DynamicResource MutedBrush}" 
                               Width="28" Height="28" Stretch="Uniform" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                               Opacity="0.4" />
                        <Image Stretch="UniformToFill" AutomationProperties.Name="Album artwork">
                            <Image.Source>
                                <Binding Path="Artwork">
                                    <Binding.FallbackValue>
                                        <BitmapImage UriSource="pack://application:,,,/TrackDot;component/Assets/PlaceholderArt.png" />
                                    </Binding.FallbackValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <controls:MarqueeTextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Height="22"
                                               ToolTip="{Binding Title}" />
                    <controls:MarqueeTextBlock Text="{Binding Artist}" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,3,0,0" Height="20"
                                               ToolTip="{Binding Artist}" />
                    
                    <!-- App Badge (Collapses when SourceAppName is empty or null) -->
                    <Border HorizontalAlignment="Left" 
                            Margin="0,8,0,0" 
                            Padding="6,2" 
                            CornerRadius="4" 
                            Background="{DynamicResource BadgeBackgroundBrush}"
                            BorderBrush="{DynamicResource BadgeBorderBrush}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SourceAppName}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SourceAppName}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SourceAppName}" 
                                   FontSize="10" 
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDynamicAccent}" Value="True">
                                            <Setter Property="Foreground" Value="{Binding DynamicAccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Seek Slider (replaces read-only ProgressBar) -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Slider x:Name="SeekSlider"
                        Minimum="0"
                        Maximum="{Binding DurationSeconds, Mode=OneWay}"
                        Value="{Binding PositionSeconds, Mode=OneWay}"
                        IsMoveToPointEnabled="True"
                        IsEnabled="{Binding CanSeek}"
                        MouseMove="SeekSlider_MouseMove"
                        MouseLeave="SeekSlider_MouseLeave"
                        AutomationProperties.Name="Track progress">
                    <Slider.Style>
                        <Style TargetType="Slider" BasedOn="{StaticResource SeekSliderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDynamicAccent}" Value="True">
                                    <Setter Property="Foreground" Value="{Binding DynamicAccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Slider.Style>
                </Slider>
            </Grid>

            <!-- Transport Controls Row -->
            <Grid Grid.Row="3" Margin="0,10,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                
                <!-- Elapsed Time -->
                <TextBlock Text="{Binding ElapsedTimeText}" 
                           Foreground="{DynamicResource MutedBrush}" 
                           FontSize="11"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
                
                <!-- 5-Button Center Controls (Shuffle, Previous, Play/Pause, Next, Repeat) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Shuffle Button -->
                    <Button Style="{StaticResource ModeTransportButton}"
                            Command="{Binding ToggleShuffleCommand}"
                            AutomationProperties.Name="Shuffle"
                            ToolTip="{Binding ShuffleToolTip}">
                        <Path Data="{Binding ShufflePathData}"
                              Width="13" Height="13" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShuffleActive}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsShuffleActive}" Value="True" />
                                                <Condition Binding="{Binding HasDynamicAccent}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                             <Setter Property="Fill" Value="{Binding DynamicAccentBrush}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <!-- Previous Track Button (Bar + Left Triangle) -->
                    <Button Style="{StaticResource SecondaryTransportButton}" 
                            Command="{Binding PreviousCommand}" 
                            AutomationProperties.Name="Previous" 
                            ToolTip="Previous Track">
                        <Path Data="M 2,2 H 5 V 14 H 2 Z M 14,2 L 5,8 L 14,14 Z" 
                               Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                               Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                    
                    <!-- Play / Pause Accent Button (Dynamic Vector Geometry) -->
                    <Button Command="{Binding TogglePlayPauseCommand}" 
                            AutomationProperties.Name="Play or pause" 
                            ToolTip="{Binding PlayPauseToolTip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryTransportButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDynamicAccent}" Value="True">
                                        <Setter Property="Background" Value="{Binding DynamicAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="{Binding PlayPausePathData}" 
                               Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                               Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    
                    <!-- Next Track Button (Right Triangle + Bar) -->
                    <Button Style="{StaticResource SecondaryTransportButton}" 
                            Command="{Binding NextCommand}" 
                            AutomationProperties.Name="Next" 
                            ToolTip="Next Track">
                        <Path Data="M 2,2 L 11,8 L 2,14 Z M 11,2 H 14 V 14 H 11 Z" 
                               Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                               Width="14" Height="14" Stretch="Uniform" />
                    </Button>

                    <!-- Repeat Button -->
                    <Button Style="{StaticResource ModeTransportButton}"
                            Command="{Binding CycleRepeatCommand}"
                            AutomationProperties.Name="Repeat"
                            ToolTip="{Binding RepeatToolTip}">
                        <Path Data="{Binding RepeatPathData}"
                              Width="13" Height="13" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRepeatActive}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsRepeatActive}" Value="True" />
                                                <Condition Binding="{Binding HasDynamicAccent}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Fill" Value="{Binding DynamicAccentBrush}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                </StackPanel>
                
                <!-- Duration Time -->
                <TextBlock Grid.Column="2" 
                           Text="{Binding DurationTimeText}" 
                           Foreground="{DynamicResource MutedBrush}" 
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Session Picker Row (only shown when 2+ SMTC sources are active) -->
            <Border Grid.Row="4"
                    Margin="0,10,0,0"
                    Visibility="{Binding HasMultipleSessions, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="SWITCH SOURCE"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"
                               Opacity="0.6" />
                    <ItemsControl ItemsSource="{Binding AvailableSessions}"
                                  AutomationProperties.Name="Session picker">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SessionPillButton}"
                                        Content="{Binding DisplayName}"
                                        Command="{Binding DataContext.SelectSessionCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding SourceAppUserModelId}"
                                        AutomationProperties.Name="{Binding DisplayName}"
                                        ToolTip="{Binding DisplayName}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Volume / Mute Row (only shown when a media session is active) -->
            <Grid Grid.Row="5"
                  Margin="0,10,0,2"
                  Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}"
                  ToolTip="It will decrease/increase audio volume on System&gt;Sound&gt;Volume Mixer&gt;Apps">
                <Grid.ColumnDefinitions>
                    <!-- Mute toggle -->
                    <ColumnDefinition Width="32" />
                    <!-- Volume slider -->
                    <ColumnDefinition Width="*" />
                    <!-- Volume % label -->
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>

                <!-- Mute Toggle Button -->
                <Button Grid.Column="0"
                        Style="{StaticResource MuteButton}"
                        Command="{Binding ToggleMuteCommand}"
                        ToolTip="{Binding MuteToolTip}"
                        AutomationProperties.Name="Toggle mute">
                    <Path Data="{Binding MuteIconPathData}"
                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Volume Slider -->
                <Slider x:Name="VolumeSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding VolumePercent, Mode=OneWay}"
                        Margin="4,0"
                        IsMoveToPointEnabled="True"
                        IsEnabled="{Binding HasMedia}"
                        ValueChanged="VolumeSlider_ValueChanged"
                        PreviewMouseLeftButtonUp="VolumeSlider_MouseLeftButtonUp"
                        PreviewMouseWheel="VolumeSlider_MouseWheel"
                        Style="{StaticResource VolumeSliderStyle}"
                        ToolTip="It will decrease/increase audio volume on System&gt;Sound&gt;Volume Mixer&gt;Apps"
                        AutomationProperties.Name="Volume" />

                <!-- Volume % Label -->
                <TextBlock Grid.Column="2"
                           Text="{Binding VolumePercent, StringFormat='{}{0}%'}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="10"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Window>